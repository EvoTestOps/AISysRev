{
  "name": "aisysrev",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 3000",
    "generate:api": "npx typed-openapi openapi.json",
    "get:openapi-spec": "node -e \"process.env.NODE_TLS_REJECT_UNAUTHORIZED='0';fetch('https://localhost:3001/openapi.json').then(r=>r.text()).then(t=>require('fs').writeFileSync('openapi.json',t))\"",
    "build": "tsc -b && vite build",
    "lint": "oxlint --report-unused-disable-directives",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "typecheck": "tsc -p tsconfig.app.json --noEmit",
    "preview": "vite preview --host 0.0.0.0 --port 3000",
    "test": "vitest run",
    "test:watch": "vitest watch",
    "coverage": "vitest run --coverage",
    "test:e2e": "npx playwright test && npx playwright show-report",
    "test:browser": "vitest --config=vitest.browser.config.ts"
  },
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@headlessui/react": "^2.2.10",
    "@mui/icons-material": "^9.4.0",
    "@mui/material": "^9.4.0",
    "@tailwindcss/postcss": "^4.3.3",
    "axios": "^1.20.0",
    "classnames": "^2.5.1",
    "easy-peasy": "^6.1.1",
    "js-cookie": "^3.0.8",
    "lucide-react": "^1.52.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-helmet-async": "^3.0.0",
    "react-loading-skeleton": "^3.5.0",
    "react-paginate": "^8.3.0",
    "react-toastify": "^11.1.0",
    "tailwind-merge": "^3.7.0",
    "wouter": "^3.13.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/js-cookie": "^3.0.6",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-basic-ssl": "^2.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/browser": "^5.0.3",
    "@vitest/browser-playwright": "^5.0.3",
    "@vitest/coverage-v8": "^5.0.3",
    "msw": "^3.0.2",
    "oxfmt": "^0.72.0",
    "oxlint": "^1.87.0",
    "postcss": "^8.5.29",
    "tailwindcss": "^4.0.0",
    "typed-openapi": "^4.1.0",
    "typescript": "~7.0.2",
    "vite": "^8.3.3",
    "vitest": "^5.0.3",
    "vitest-browser-react": "^2.3.0"
  }
}
